{
    "name": "atriametal/sylius-cookie-consent-plugin",
    "description": "Collects the cookie consent of the visitors of a Sylius shop, blocks scripts and embedded contents until they consent, and keeps a proof of each consent.",
    "type": "sylius-plugin",
    "license": "MIT",
    "homepage": "https://github.com/atriametal/sylius-cookie-consent-plugin",
    "authors": [
        {
            "name": "Atriametal",
            "email": "contact@kemp.fr",
            "homepage": "https://github.com/atriametal"
        }
    ],
    "support": {
        "issues": "https://github.com/atriametal/sylius-cookie-consent-plugin/issues",
        "source": "https://github.com/atriametal/sylius-cookie-consent-plugin",
        "security": "https://github.com/atriametal/sylius-cookie-consent-plugin/security/policy"
    },
    "keywords": [
        "sylius",
        "sylius-plugin",
        "cookie",
        "consent",
        "gdpr",
        "rgpd"
    ],
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^3.3 || ^4.0",
        "doctrine/migrations": "^3.5",
        "doctrine/orm": "^2.14 || ^3.0",
        "knplabs/knp-menu": "^3.1",
        "sylius/sylius": "^1.14 || ^2.0",
        "symfony/config": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/console": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/http-foundation": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/routing": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^3.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^1.14.0@alpha || ^2.0.0@alpha",
        "symfony/browser-kit": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/cache": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^5.4.21 || ^6.4 || ^7.4 || ^8.0",
        "symfony/twig-bridge": "^5.4.21 || ^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Atriametal\\SyliusCookieConsentPlugin\\": "src/",
            "Atriametal\\SyliusCookieConsentPlugin\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Atriametal\\SyliusCookieConsentPlugin\\": "tests/"
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-8kfs-m8zw-ggzs": "Sylius 1.14 requires api-platform/core 2.7, which has no patched release. This plugin does not use API Platform.",
                    "PKSA-3ncz-km6v-5vjr": "Sylius 1.14 requires api-platform/core 2.7, which has no patched release. This plugin does not use API Platform.",
                    "PKSA-gs8r-6kz6-pp56": "Sylius 1.14 requires api-platform/core 2.7, which has no patched release. This plugin does not use API Platform.",
                    "PKSA-gnn4-pxdg-q76m": "Sylius 1.14 requires api-platform/core 2.7, which has no patched release. This plugin does not use API Platform."
                }
            }
        }
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    }
}
