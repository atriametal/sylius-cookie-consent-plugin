<link rel="stylesheet" href="{{ asset('bundles/atriametalsyliuscookieconsentplugin/cookie-consent.css') }}">
{% set google_consent_mode_signals = cookie_consent_client_config().googleConsentMode %}
{% if google_consent_mode_signals is not empty %}
    {# Sends the choice already made by the visitor, or denies, before a Google tag loads: Google tags evaluate each
       event of the data layer with the consent of that moment, and the browser script only runs after the page has
       pushed its own events (a purchase on the thank you page). The browser script then sends the new choices. #}
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('consent', 'default', {{ google_consent_mode_signals|map(category => cookie_consent_granted(category) ? 'granted' : 'denied')|merge({ wait_for_update: 500 })|json_encode|raw }});
    </script>
{% endif %}
